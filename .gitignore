# ------------------------------------------------------------------------------
# Security, Environment Variables & Required Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# Streamlit secrets & local config
.streamlit/secrets.toml

# Cloud / API Service Credentials & Tokens
*.pem
*.key
*.pfx
*.p12
*.crt
credentials.json
client_secret*.json
service_account*.json
token.json
auth.json
*.id_rsa
*.id_ed25519
api_key*.txt
api_key*.json

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------------------------
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Local Vector Databases & Model Caches
# ------------------------------------------------------------------------------
chroma_db/
.chroma/
fastembed_cache/
.cache/
data/cache/

# ------------------------------------------------------------------------------
# IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# Logs & Testing
# ------------------------------------------------------------------------------
*.log
.pytest_cache/
.coverage
htmlcov/
